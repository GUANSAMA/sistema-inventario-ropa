@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle

package "Entities" {
  class Prenda {
    - idPrenda : int
    - codigoSKU : string
    - nombre : string
    - categoriaId : int
    - tallaId : int
    - colorId : int
    - marca : string
    - precio : decimal
    - stock : int
    - stockMinimo : int
    - activo : bool
    + Validar() : bool
  }

  class Categoria {
    - idCategoria : int
    - nombre : string
    - activo : bool
  }

  class Talla {
    - idTalla : int
    - nombre : string
    - activo : bool
  }

  class Color {
    - idColor : int
    - nombre : string
    - activo : bool
  }

  class UsuarioSistema {
    - idUsuario : int
    - nombreUsuario : string
    - nombreCompleto : string
    - passwordHash : string
    - passwordSalt : string
    - rol : string
    - activo : bool
    + VerificarPassword(password : string) : bool
  }

  class AuditoriaInventario {
    - idAuditoria : int
    - idPrenda : int
    - idUsuario : int
    - operacion : string
    - fechaHora : DateTime
    - valoresAnteriores : string
    - valoresNuevos : string
  }
}

package "BLL" {
  class AutenticacionBLL {
    + IniciarSesion(usuario : string, password : string) : UsuarioSistema
  }

  class PrendaBLL {
    + Listar() : List<Prenda>
    + Buscar(texto : string) : List<Prenda>
    + Filtrar(categoriaId : int, tallaId : int, colorId : int, activo : bool) : List<Prenda>
    + Registrar(prenda : Prenda, usuarioId : int) : bool
    + Actualizar(prenda : Prenda, usuarioId : int) : bool
    + Desactivar(idPrenda : int, usuarioId : int) : bool
    - Validar(prenda : Prenda) : void
  }

  class CatalogoBLL {
    + ListarCategorias() : List<Categoria>
    + ListarTallas() : List<Talla>
    + ListarColores() : List<Color>
  }

  class AuditoriaBLL {
    + Listar(fechaInicio : DateTime?, fechaFin : DateTime?) : List<AuditoriaInventario>
  }

  class ReporteService {
    + GenerarInventarioPDF(datos : List<Prenda>, ruta : string) : void
    + GenerarAuditoriaPDF(datos : List<AuditoriaInventario>, ruta : string) : void
  }
}

package "DAL" {
  class Conexion {
    - cadenaConexion : string
    + ObtenerConexion() : SqlConnection
  }

  class PrendaDAL {
    + Listar() : List<Prenda>
    + Buscar(texto : string) : List<Prenda>
    + Filtrar(...) : List<Prenda>
    + Insertar(prenda : Prenda, usuarioId : int) : bool
    + Actualizar(prenda : Prenda, usuarioId : int) : bool
    + Desactivar(idPrenda : int, usuarioId : int) : bool
  }

  class CatalogoDAL {
    + ListarCategorias() : List<Categoria>
    + ListarTallas() : List<Talla>
    + ListarColores() : List<Color>
  }

  class UsuarioDAL {
    + ObtenerPorNombre(usuario : string) : UsuarioSistema
    + Insertar(usuario : UsuarioSistema) : bool
    + Desactivar(idUsuario : int) : bool
  }

  class AuditoriaDAL {
    + Listar(...) : List<AuditoriaInventario>
  }
}

package "UI" {
  class LoginForm
  class PrendaForm
  class AuditoriaForm
  class ReporteForm
  class UsuarioForm
}

Prenda "N" --> "1" Categoria
Prenda "N" --> "1" Talla
Prenda "N" --> "1" Color
AuditoriaInventario "N" --> "1" Prenda
AuditoriaInventario "N" --> "1" UsuarioSistema

LoginForm --> AutenticacionBLL
PrendaForm --> PrendaBLL
PrendaForm --> CatalogoBLL
AuditoriaForm --> AuditoriaBLL
ReporteForm --> ReporteService
UsuarioForm --> AutenticacionBLL
UsuarioForm --> UsuarioDAL

AutenticacionBLL --> UsuarioDAL
PrendaBLL --> PrendaDAL
CatalogoBLL --> CatalogoDAL
AuditoriaBLL --> AuditoriaDAL
PrendaDAL --> Conexion
CatalogoDAL --> Conexion
UsuarioDAL --> Conexion
AuditoriaDAL --> Conexion

note right of AuditoriaInventario
Los registros se crean mediante
triggers de SQL Server después
de operaciones sobre Prenda.
end note

note bottom of Prenda
precio: DECIMAL(10,0) en SQL Server
y decimal en C#.
activo: desactivación lógica.
end note
@enduml
