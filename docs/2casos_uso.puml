@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #1E3A8A
}

actor "Administrador" as Admin
actor "Operador de Bodega" as Operador
actor "Sistema" as Sistema

rectangle "Sistema de Inventario de Ropa" {
  usecase "RF01\nIniciar sesión" as UC01
  usecase "RF02\nGestionar prendas" as UC02
  usecase "Registrar prenda" as UC02a
  usecase "Consultar prendas" as UC02b
  usecase "Modificar prenda" as UC02c
  usecase "Desactivar prenda" as UC02d
  usecase "RF03\nConsultar catálogos" as UC03
  usecase "RF04\nBuscar y filtrar inventario" as UC04
  usecase "RF05\nValidar precio y stock" as UC05
  usecase "RF06\nRegistrar auditoría" as UC06
  usecase "RF07\nConsultar auditoría" as UC07
  usecase "RF08\nGenerar reportes PDF" as UC08
  usecase "Generar PDF de inventario" as UC08a
  usecase "Generar PDF de auditoría" as UC08b
  usecase "RF09\nGestionar usuarios" as UC09
}

Admin --> UC01
Admin --> UC02
Admin --> UC03
Admin --> UC04
Admin --> UC07
Admin --> UC08
Admin --> UC09

Operador --> UC01
Operador --> UC02b
Operador --> UC02a
Operador --> UC02c
Operador --> UC03
Operador --> UC04

Sistema --> UC05
Sistema --> UC06

UC02 .> UC05 : <<include>>
UC02a .> UC06 : <<include>>
UC02c .> UC06 : <<include>>
UC02d .> UC06 : <<include>>
UC08 .> UC08a : <<include>>
UC08 .> UC08b : <<include>>
UC02a .> UC03 : <<include>>
UC02c .> UC03 : <<include>>
UC07 .> UC01 : <<include>>
UC08 .> UC01 : <<include>>
UC09 .> UC01 : <<include>>

note right of UC06
La auditoría se registra automáticamente
mediante triggers en SQL Server.
Se auditan INSERT, UPDATE y DESACTIVAR.
end note

note bottom of UC08
Los reportes PDF son obligatorios.
Se utiliza SaveFileDialog para seleccionar la ruta.
end note
@enduml
